# Build de producción del frontend: build estático (Vite) servido por Caddy, que además hace
# de reverse-proxy/TLS para todo el dominio — ver Caddyfile y docs/DEPLOY.md. A diferencia de
# Dockerfile (dev, corre `vite dev` con bind mount), acá no hay contenedor "frontend" en prod:
# este mismo servicio "caddy" en docker-compose.prod.yml es el único punto de entrada HTTP/HTTPS.
FROM node:22-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# VITE_API_BASE_URL vacío a propósito: en prod el frontend y la API comparten origen (Caddy
# proxea /api y /media al backend), así que las requests quedan relativas — ver src/api/client.ts.
ENV VITE_API_BASE_URL=
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
