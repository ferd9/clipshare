## Build de producción: jar ejecutable real, sin bind mounts ni recompilar en cada arranque
## (a diferencia de Dockerfile, que corre `mvnw spring-boot:run` en modo dev). Ver docs/DEPLOY.md.
FROM eclipse-temurin:21-jdk AS build

WORKDIR /app
COPY .mvn/ .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -B dependency:go-offline

COPY src ./src
# Los tests ya corren en desarrollo (ver docs/SPEC.md) y no hay workflow de CI que los repita
# en cada push — -DskipTests acá es solo para no duplicar ese trabajo en el build de la imagen.
RUN ./mvnw -B package -DskipTests

FROM eclipse-temurin:21-jre

# ffmpeg + yt-dlp: el backend hace síncrono (en el propio request) el chequeo de duración de un
# link externo antes de encolar la descarga completa, y también sube/procesa audio de reemplazo —
# mismo motivo que en el Dockerfile de dev.
RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y ffmpeg curl && rm -rf /var/lib/apt/lists/* \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

WORKDIR /app
# El plugin de Spring Boot deja un único jar ejecutable en target/ (el original pre-repackage
# queda como *.jar.original, no matchea este glob).
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
