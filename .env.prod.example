# Plantilla del .env real de producción (Hetzner) — ver docs/DEPLOY.md. Este archivo SÍ se
# trackea (son solo nombres/comentarios, sin valores reales); copiarlo a ".env" en el servidor
# y completar los valores ahí. ".env" está en .gitignore — nunca commitear los valores reales.
#
# docker-compose.prod.yml lee estas variables directamente (no hay perfil "prod" de Spring
# aparte: la diferencia con dev está toda acá + en qué Dockerfile/compose se usa).

# Dominio real apuntando al IP del servidor (ver paso 2 de docs/DEPLOY.md) — usado por Caddy
# para el certificado TLS y por el backend para CORS/links de email.
DOMAIN=clips.tudominio.com

# Generar cada uno con: openssl rand -base64 48
# (nunca reusar los valores "change-me-in-dev" del .env.example de desarrollo)
JWT_SECRET=
ANON_SESSION_COOKIE_SECRET=
TURNSTILE_SECRET_KEY=

# Password real de Postgres (docker-compose.prod.yml ya no usa "dev"/"dev" como en desarrollo).
POSTGRES_PASSWORD=

# Email transaccional real — mismas credenciales de Resend que ya se usaban en el despliegue
# de Google Cloud (ver ResendEmailService). Sin esto, el backend cae a "logging" (el email de
# verificación solo queda en los logs, nadie lo recibe de verdad).
APP_EMAIL_PROVIDER=resend
RESEND_API_KEY=
APP_EMAIL_FROM=

# ---------------------------------------------------------------------------
# NO configurado en este despliegue (decisión explícita, ver docs/DEPLOY.md):
# - MODERATION_CSAM_PROVIDER queda "mock" (sin hash-matching real todavía).
# - APP_TURNSTILE_PROVIDER queda "mock" (acepta cualquier token, sin protección anti-bot real).
# - Storage local (no Cloudflare R2 todavía) — no hace falta S3_ENDPOINT/S3_BUCKET/etc. acá.
# No anunciar/linkear el sitio públicamente hasta resolver esto + el agente DMCA + NCMEC ESP.
# ---------------------------------------------------------------------------
